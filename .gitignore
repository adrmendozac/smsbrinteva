# Dependencies (installed per-host, never committed)
node_modules/

# Secrets / env
.env
.env.*

# Backup snapshots (index.js.bak.<timestamp> convention)
*.bak
*.bak.*

# OS / editor cruft
.DS_Store
*.log

# Build outputs we do NOT deploy (the admin-ui build in public/admin IS committed on purpose)
admin-ui/dist/
inbox-ui/dist/

# Isolated feature worktrees
.worktrees/

# Local agent planning documents (README.md is the GitHub-facing documentation)
docs/superpowers/plans/
docs/superpowers/specs/

# Local scratch preview of a hosted itinerary page (lib/hosted.js renders these
# live at /i/:code; this file is just for eyeballing template/CSS changes)
itinerario.html

# Local generator for the two-itinerary customer-page preview.
tests/render-two-itineraries-preview.js
